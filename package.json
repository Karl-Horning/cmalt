{
  "name": "cmalt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check-links": "linkinator https://cmalt.karlhorning.dev --recurse --skip '^mailto:' --timeout 10000",
