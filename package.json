    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:og-images": "node scripts/generate-og-images.mjs",
    "check:generated-assets": "node scripts/check-generated-assets.mjs"
  },
  "dependencies": {
    "fuse.js": "^7.3.0",
